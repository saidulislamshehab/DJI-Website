# ==========================================
# DJI Drone Store Backend - Environment Variables
# ==========================================

# Server Settings
# (Render automatically sets PORT in production)
PORT=5000
NODE_ENV=production

# Frontend URL for CORS (comma-separated if multiple, e.g. https://your-site.vercel.app,http://localhost:3000)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Database (MongoDB Atlas)
# Recommended for production. If omitted or unreachable, backend gracefully uses persistent local db.json
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/d1store?retryWrites=true&w=majority
MONGODB_DB_NAME=d1store

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# Admin Permissions (comma-separated emails allowed to access admin routes)
ADMIN_EMAILS=admin@d1store.com.au,user@example.com

# Email Notifications / Nodemailer (Optional)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
